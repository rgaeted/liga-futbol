generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ORG_ADMIN
  COACH
  REFEREE
  PLAYER
  FRIENDLY_COACH
}

enum OrganizationStatus {
  ACTIVE
  PAUSED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  HALFTIME
  FINISHED
  CANCELLED
}

enum EventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SHOT_ON_TARGET
  SHOT_OFF_TARGET
  SUBSTITUTION
  FOUL
  KICKOFF
  HALFTIME
  FULLTIME
}

enum MatchType {
  LEAGUE
  FRIENDLY
}

enum ChallengeStatus {
  NONE
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum FriendlySide {
  A
  B
}

enum FootballFormat {
  FUTBOL_5
  FUTBOL_6
  FUTBOL_7
  FUTBOL_11
}

enum MatchMvpSide {
  HOME
  AWAY
}

enum SeasonTeamStatus {
  REGISTERED
  WITHDRAWN
}

enum SeasonRosterStatus {
  ACTIVE
  INACTIVE
}

enum EditorialStatus {
  DRAFT
  PUBLISHED
}

enum SponsorPlacement {
  HOME
  SPONSORS_PAGE
  FOOTER
}

enum DominantFoot {
  RIGHT
  LEFT
  BOTH
}

enum MobilePlatform {
  IOS
  ANDROID
}

enum MobileInstallationStatus {
  ACTIVE
  INACTIVE
}

enum NotificationKind {
  MATCH_START
  GOAL
  MATCH_FINISH
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  INVALID_TOKEN
}

enum RefereeShareInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  isPlatformAdmin  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  person           Person?
  coachedTeam      Team?    @relation("TeamCoach")
  refereeMatches   Match[]  @relation("MatchReferee")
  articles         Article[]
  memberships      OrganizationMembership[]
  refereeProfile         RefereeProfile?
  refereeShareInvites    RefereeShareInvite[] @relation("RefereeShareReferee")
  refereeShareInvitesSent RefereeShareInvite[] @relation("RefereeShareInvitedBy")
}

model Person {
  id            String   @id @default(cuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName     String
  lastName      String
  photoMimeType String?
  photoData     Bytes?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  players          Player[]
}

model Organization {
  id               String             @id @default(cuid())
  slug             String             @unique
  name             String
  logoStoragePath  String?
  primaryColor     String
  secondaryColor   String
  status           OrganizationStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  memberships      OrganizationMembership[]
  seasons          Season[]
  teams            Team[]
  matches          Match[]
  guestMatches     Match[] @relation("MatchGuestOrg")
  friendlyCategories FriendlyCategory[]
  players          Player[]
  articles         Article[]
  galleries        Gallery[]
  sponsors         Sponsor[]
  refereeSharesFrom RefereeShareInvite[] @relation("RefereeShareFrom")
  refereeSharesTo   RefereeShareInvite[] @relation("RefereeShareTo")
}

model RefereeProfile {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?
  whatsapp         String?
  notes            String?
  photoStoragePath String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RefereeShareInvite {
  id                 String                   @id @default(cuid())
  refereeUserId      String
  refereeUser        User                     @relation("RefereeShareReferee", fields: [refereeUserId], references: [id], onDelete: Cascade)
  fromOrganizationId String
  fromOrganization   Organization             @relation("RefereeShareFrom", fields: [fromOrganizationId], references: [id], onDelete: Cascade)
  toOrganizationId   String
  toOrganization     Organization             @relation("RefereeShareTo", fields: [toOrganizationId], references: [id], onDelete: Cascade)
  invitedByUserId    String
  invitedByUser      User                     @relation("RefereeShareInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  status             RefereeShareInviteStatus @default(PENDING)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([toOrganizationId, status])
  @@index([refereeUserId])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

model Team {
  id            String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name          String
  logoUrl       String?
  crestMimeType String?
  crestData     Bytes?
  color         String?
  coachId       String?  @unique
  coach     User?    @relation("TeamCoach", fields: [coachId], references: [id])
  players   Player[]
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  seasonTeams SeasonTeam[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id])
  jerseyNumber   Int?
  position       String?
  dominantFoot        DominantFoot?
  primaryPosition     String?
  secondaryPosition   String?
  goals          Int          @default(0)
  assists        Int          @default(0)
  yellowCards    Int          @default(0)
  redCards       Int          @default(0)
  callUps        CallUp[]
  evaluations    PlayerEvaluation[]
  matchEvents    MatchEvent[]
  goalAssists    MatchEvent[] @relation("GoalAssists")
  teamMvps       MatchTeamMvp[]
  seasonRosterEntries SeasonRosterEntry[]
  categories          PlayerCategory[]
  friendlyParticipations FriendlyMatchPlayer[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([personId, organizationId])
  @@index([organizationId])
}

model Season {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime
  endDate        DateTime
  footballFormat FootballFormat @default(FUTBOL_11)
  isActive       Boolean        @default(true)
  matches        Match[]
  mobileConfig   SeasonMobileConfig?
  seasonTeams    SeasonTeam[]
  seasonCategories SeasonCategory[]
  articles              Article[]
  galleries             Gallery[]
  sponsors              Sponsor[]
  mobileInstallations   MobileInstallation[]
  notificationOutbox    NotificationOutbox[]
  createdAt             DateTime       @default(now())
}

model SeasonCategory {
  id         String   @id @default(cuid())
  seasonId   String
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  categoryId String
  category   FriendlyCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sortOrder  Int      @default(0)
  seasonTeams SeasonTeam[]
  matches     Match[]
  createdAt  DateTime @default(now())

  @@unique([seasonId, categoryId])
  @@index([seasonId, sortOrder])
}

model FriendlyCategory {
  id          String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean  @default(true)
  playerLinks PlayerCategory[]
  seasonCategories SeasonCategory[]
  matches     Match[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Match {
  id           String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matchType    MatchType   @default(LEAGUE)
  seasonId     String?
  season       Season?     @relation(fields: [seasonId], references: [id])
  seasonCategoryId String?
  seasonCategory   SeasonCategory? @relation(fields: [seasonCategoryId], references: [id], onDelete: Restrict)
  homeTeamId   String?
  homeTeam     Team?       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String?
  awayTeam     Team?       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  sideAName    String?
  sideBName    String?
  sideACrestMimeType String?
  sideACrestData     Bytes?
  sideBCrestMimeType String?
  sideBCrestData     Bytes?
  sideAColor         String?
  sideBColor         String?
  friendlyCategoryId String?
  friendlyCategory   FriendlyCategory? @relation(fields: [friendlyCategoryId], references: [id])
  footballFormat     FootballFormat    @default(FUTBOL_11)
  refereeId    String?
  referee      User?       @relation("MatchReferee", fields: [refereeId], references: [id])
  scheduledAt  DateTime
  venue        String?
  regionCode   String?
  regionName   String?
  communeCode  String?
  communeName  String?
  communeLat   Float?
  communeLon   Float?
  weatherTempC       Float?
  weatherHumidityPct Int?
  weatherWindKmh     Float?
  weatherCode        Int?
  weatherLabel       String?
  weatherFetchedAt   DateTime?
  status       MatchStatus @default(SCHEDULED)
  homeScore    Int         @default(0)
  awayScore    Int         @default(0)
  clockStartedAt      DateTime?
  secondHalfStartedAt DateTime?
  halftimeAt          DateTime?
  refereeEventTypes   EventType[] @default([])
  events       MatchEvent[]
  callUps      CallUp[]
  friendlyPlayers FriendlyMatchPlayer[]
  formations   MatchFormation[]
  teamMvps            MatchTeamMvp[]
  notificationOutbox  NotificationOutbox[]
  guestOrganizationId String?
  guestOrganization   Organization? @relation("MatchGuestOrg", fields: [guestOrganizationId], references: [id], onDelete: Restrict)
  challengeStatus     ChallengeStatus @default(NONE)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([guestOrganizationId, challengeStatus])
  @@index([seasonCategoryId])
}

model MatchFormation {
  id        String        @id @default(cuid())
  matchId   String
  match     Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId    String?
  side      FriendlySide?
  scheme    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([matchId, teamId])
  @@unique([matchId, side])
}

model MatchEvent {
  id          String    @id @default(cuid())
  matchId     String
  match       Match     @relation(fields: [matchId], references: [id])
  type        EventType
  minute      Int
  playerId    String?
  player      Player?   @relation(fields: [playerId], references: [id])
  assistPlayerId   String?
  assistPlayer     Player?         @relation("GoalAssists", fields: [assistPlayerId], references: [id])
  side             FriendlySide?
  teamId      String?
  description String?
  metadata           Json?
  notificationOutbox NotificationOutbox[]
  createdAt          DateTime  @default(now())
}

model CallUp {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  isStarter Boolean  @default(false)
  slotKey   String?
  createdAt DateTime @default(now())

  @@unique([matchId, playerId])
}

model PlayerEvaluation {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  coachId   String
  matchId   String?
  rating    Int
  notes     String?
  createdAt DateTime @default(now())
}

model PlayerCategory {
  playerId           String
  player             Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  friendlyCategoryId String
  friendlyCategory   FriendlyCategory @relation(fields: [friendlyCategoryId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@id([playerId, friendlyCategoryId])
}

model FriendlyMatchPlayer {
  id               String         @id @default(cuid())
  matchId          String
  match            Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId         String
  player           Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  side             FriendlySide
  paid             Boolean        @default(false)
  isGalleta        Boolean        @default(false)
  isStarter        Boolean        @default(false)
  isCaptain        Boolean        @default(false)
  isCoach          Boolean        @default(false)
  slotKey          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([matchId, playerId])
}

model MatchTeamMvp {
  id               String       @id @default(cuid())
  matchId          String
  match            Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  side             MatchMvpSide
  playerId         String?
  player           Player?      @relation(fields: [playerId], references: [id], onDelete: SetNull)
  photoMimeType    String?
  photoData        Bytes?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([matchId, side])
}

model SeasonMobileConfig {
  seasonId         String   @id
  season           Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  slug             String   @unique
  displayName      String
  shortName        String?
  description      String?
  logoStoragePath  String?
  primaryColor     String?
  secondaryColor   String?
  isPublished      Boolean  @default(false)
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SeasonTeam {
  id             String           @id @default(cuid())
  seasonId       String
  season         Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonCategoryId String?
  seasonCategory SeasonCategory?  @relation(fields: [seasonCategoryId], references: [id], onDelete: Restrict)
  teamId         String
  team           Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  displayName    String
  color          String?
  crestMimeType  String?
  crestData      Bytes?
  status         SeasonTeamStatus @default(REGISTERED)
  sortOrder      Int              @default(0)
  rosterEntries     SeasonRosterEntry[]
  teamSubscriptions TeamSubscription[]
  notificationOutbox NotificationOutbox[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([seasonCategoryId, teamId])
  @@index([seasonId, status])
}

model SeasonRosterEntry {
  id            String             @id @default(cuid())
  seasonTeamId  String
  seasonTeam    SeasonTeam         @relation(fields: [seasonTeamId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  jerseyNumber  Int?
  position      String?
  status        SeasonRosterStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([seasonTeamId, playerId])
  @@index([seasonTeamId, status])
}

model Article {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seasonId         String
  season           Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  title            String
  summary          String?
  body             String
  coverStoragePath String?
  coverMimeType    String?
  status           EditorialStatus @default(DRAFT)
  publishedAt      DateTime?
  authorId         String
  author           User            @relation(fields: [authorId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([seasonId, status, publishedAt])
}

model Gallery {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seasonId         String
  season           Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  coverStoragePath String?
  coverMimeType    String?
  status           EditorialStatus @default(DRAFT)
  publishedAt      DateTime?
  sortOrder        Int             @default(0)
  photos           GalleryPhoto[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([seasonId, status, publishedAt])
}

model GalleryPhoto {
  id          String   @id @default(cuid())
  galleryId   String
  gallery     Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  storagePath String
  mimeType    String
  altText     String?
  caption     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([galleryId, sortOrder])
}

model Sponsor {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seasonId          String
  season            Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name              String
  logoStoragePath   String?
  logoMimeType      String?
  bannerStoragePath String?
  bannerMimeType    String?
  websiteUrl        String?
  placement         SponsorPlacement @default(SPONSORS_PAGE)
  startsAt          DateTime?
  endsAt            DateTime?
  isActive          Boolean          @default(true)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([seasonId, isActive, sortOrder])
}

model MobileInstallation {
  id            String                   @id
  seasonId      String
  season        Season                   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  expoPushToken String
  platform      MobilePlatform
  appVersion    String?
  status        MobileInstallationStatus @default(ACTIVE)
  lastSeenAt    DateTime
  subscriptions TeamSubscription[]
  deliveries    NotificationDelivery[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([seasonId, status])
}

model TeamSubscription {
  installationId   String
  installation       MobileInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  seasonTeamId       String
  seasonTeam         SeasonTeam         @relation(fields: [seasonTeamId], references: [id], onDelete: Cascade)
  notifyMatchStart   Boolean            @default(true)
  notifyGoals        Boolean            @default(true)
  notifyFinal        Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@id([installationId, seasonTeamId])
  @@index([seasonTeamId])
}

model NotificationOutbox {
  id            String                   @id @default(cuid())
  seasonId      String
  season        Season                   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  matchId       String
  match         Match                    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  kind          NotificationKind
  seasonTeamId  String?
  seasonTeam    SeasonTeam?              @relation(fields: [seasonTeamId], references: [id], onDelete: SetNull)
  matchEventId  String?
  matchEvent    MatchEvent?              @relation(fields: [matchEventId], references: [id], onDelete: SetNull)
  payload       Json
  status        NotificationOutboxStatus @default(PENDING)
  dedupeKey     String                   @unique
  attempts      Int                      @default(0)
  nextRetryAt   DateTime?
  lastError     String?
  deliveries    NotificationDelivery[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([status, nextRetryAt])
  @@index([seasonId, matchId])
}

model NotificationDelivery {
  id              String                     @id @default(cuid())
  outboxId        String
  outbox          NotificationOutbox         @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  installationId  String
  installation    MobileInstallation         @relation(fields: [installationId], references: [id], onDelete: Cascade)
  status          NotificationDeliveryStatus @default(PENDING)
  expoTicketId    String?
  attempts        Int                        @default(0)
  lastError       String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([outboxId, installationId])
  @@index([installationId, status])
}