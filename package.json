{
  "name": "liga-futbol",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "npm run test --workspace @liga/mobile-contracts",
    "test:mobile": "npm run test --workspace @liga/mobile",
    "typecheck:mobile": "npm run typecheck --workspace @liga/mobile",
    "lint:mobile": "npm run lint --workspace @liga/mobile",
    "mobile:assets": "node scripts/generate-mobile-edition-assets.mjs",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:liga-le-park": "tsx scripts/seed-liga-le-park.ts",
    "db:ensure:kelme": "tsx scripts/ensure-kelme-organization.ts",
    "db:clear:demo": "tsx prisma/clear-demo.ts",
    "db:verify:migration": "tsx scripts/verify-database-migration.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.112.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "zod": "^4.4.3",
    "@liga/mobile-contracts": "*",
    "@liga/mobile-core": "*"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "prisma": "^7.8.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
