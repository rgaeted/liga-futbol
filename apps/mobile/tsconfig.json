{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@liga/mobile-contracts": [
        "../../packages/mobile-contracts/src/index.ts"
      ],
      "@liga/mobile-contracts/schemas": [
        "../../packages/mobile-contracts/src/schemas/index.ts"
      ],
      "@liga/mobile-core": [
        "../../packages/mobile-core/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "src/test/**",
    "tests/**",
    "components/**"
  ]
}
