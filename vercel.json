{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/health/database",
      "schedule": "0 12 * * *"
    }
  ],
  "services": {
    "torneos-kelme": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm ci --include=dev && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "torneos-kelme" }
    }
  ]
}
